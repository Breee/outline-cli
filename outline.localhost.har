ark?i.hexColorSwatchDark:i.hexColorSwatchLight} {\n  outline: 1px solid ${e.theme.codeBorder};\n}\n\nmark {\n  border-radius: 1px;\n  padding: 2px 0;\n  color: ${e.theme.text};\n\n  a {\n    color: ${e.theme.text};\n  }\n}\n\n.external-link {\n  cursor: pointer;\n  display: inline-block;\n  position: relative;\n  top: 2px;\n  width: 16px;\n  height: 16px;\n}\n\n.${i.codeBlock} {\n  position: relative;\n  font-size: 90%;\n\n  &:hover + .${i.codeBlockToggle},\n  &:focus-within + .${i.codeBlockToggle},\n  & + .${i.codeBlockToggle}:hover,\n  & + .${i.codeBlockToggle}:focus {\n    opacity: 1;\n  }\n}\n\n.${i.codeBlock}[data-language=none],\n.${i.codeBlock}[data-language=markdown] {\n  pre code {\n    color: ${e.theme.text};\n  }\n}\n\n.${i.codeBlock}[data-language=mermaid],\n.${i.codeBlock}[data-language=mermaidjs] {\n  ${!e.staticHTML&&n`\n      pre {\n        border-bottom-left-radius: 0;\n        border-bottom-right-radius: 0;\n        margin-bottom: -20px;\n        overflow: hidden;\n      }\n    `}\n\n  &:is(.code-active) + .mermaid-diagram-wrapper {\n    cursor: zoom-in;\n  }\n\n  // Hide code without display none so toolbar can still be positioned against it\n  &:not(.code-active) {\n    height: ${e.staticHTML||e.readOnly?`auto`:`0`};\n    margin: 0.5em 0 -0.75em 0px;\n    overflow: hidden;\n    position: relative;\n  }\n\n  &.ProseMirror-selectednode {\n    outline: none;\n\n    & + .mermaid-diagram-wrapper {\n      &:not(.empty) {\n        cursor: zoom-in;\n      }\n      outline: 2px solid ${e.theme.selected};\n    }\n  }\n}\n\n.ProseMirror[contenteditable=\"false\"] .${i.codeBlock}[data-language=mermaid],\n.ProseMirror[contenteditable=\"false\"] .${i.codeBlock}[data-language=mermaidjs] {\n    height: 0;\n    overflow: hidden;\n\n    & + .mermaid-diagram-wrapper {\n      cursor: zoom-in;\n    }\n}\n\n.ProseMirror.exported {\n    .${i.codeBlock}[data-language=mermaid],\n    .${i.codeBlock}[data-language=mermaidjs] {\n        height: auto;\n        overflow: visible;\n\n        &::after {\n          display: none;\n        }\n    }\n\n    .mermaid-diagram-wrapper {\n        display: none;\n    }\n}\n\n.${i.codeBlock}.with-line-wrap {\n  pre {\n    white-space: pre-wrap;\n    word-break: break-all;\n  }\n}\n\n.${i.codeBlock}.with-line-numbers {\n  pre {\n    padding-left: calc(var(--line-number-gutter-width, 0) * 1em + 1.5em);\n  }\n\n  &::after {\n    content: attr(data-line-numbers);\n    position: absolute;\n    padding-left: 0.5em;\n    left: 1px;\n    top: calc(1px + 0.75em);\n    width: calc(var(--line-number-gutter-width,0) * 1em + .25em);\n    word-break: break-all;\n    white-space: break-spaces;\n    font-family: ${e.theme.fontFamilyMono};\n    line-height: 1.4em;\n    color: ${e.theme.textTertiary};\n    background: ${e.theme.codeBackground};\n    text-align: right;\n    font-variant-numeric: tabular-nums;\n    user-select: none;\n  }\n}\n\n.${i.codeBlock}.collapsed {\n  pre {\n    pointer-events: none;\n    max-height: calc(10 * 1.4em + 0.75em);\n    overflow: hidden;\n  }\n\n  &::after {\n    max-height: calc(10 * 1.4em + 0.75em);\n    overflow: hidden;\n    clip-path: inset(0 0 calc(100% - 10 * 1.4em - 0.75em) 0);\n  }\n\n  &::before {\n    content: \"\";\n    position: absolute;\n    bottom: 1px;\n    left: 1px;\n    right: 1px;\n    height: 120px;\n    z-index: 1;\n    pointer-events: none;\n    border-radius: 0 0 4px 4px;\n    background: linear-gradient(\n      to bottom,\n      ${o(1,e.theme.codeBackground)} 0%,\n      ${o(.2,e.theme.codeBackground)} 70%,\n      ${e.theme.codeBackground} 100%\n    );\n  }\n\n  @media print {\n    pre {\n      max-height: none;\n      overflow: visible;\n    }\n\n    &::after {\n      max-height: none;\n      overflow: visible;\n      clip-path: none;\n    }\n\n    &::before {\n      display: none;\n    }\n  }\n}\n\n.${i.codeBlockToggle} {\n  display: inline-flex;\n  align-items: center;\n  position: absolute;\n  z-index: 2;\n  left: 50%;\n  transform: translate3d(-50%, -50px, 0);\n  margin: 0;\n  padding: 0 8px;\n  border: 0;\n  border-radius: 100px;\n  background: ${e.theme.background};\n  color: ${e.theme.buttonNeutralText};\n  box-shadow: rgba(0, 0, 0, 0.07) 0px 1px 2px, ${e.theme.buttonNeutralBorder} 0 0 0 1px inset;\n  font-size: 13px;\n  font-weight: 500;\n  height: 24px;\n  cursor: var(--pointer);\n  user-select: none;\n  appearance: none !important;\n  opacity: 0;\n  transition: opacity 150ms ease;\n  pointer-events: auto;\n\n  &:hover {\n    background: ${e.theme.backgroundSecondary};\n  }\n\n  @media print {\n    display: none !important;\n  }\n}\n\n.mermaid-diagram-wrapper {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin: 0.75em 0;\n  min-height: 1.6em;\n  background: ${e.theme.codeBackground};\n  border-radius: ${i.blockRadius};\n  border: 1px solid ${e.theme.codeBorder};\n  padding: 8px;\n  user-select: none;\n  cursor: default;\n\n  * {\n    font-family: ${e.theme.fontFamily};\n  }\n\n  &.empty {\n    font-family: ${e.theme.fontFamilyMono};\n    font-size: 14px;\n    color: ${e.theme.placeholder};\n  }\n\n  &.parse-error {\n    font-family: ${e.theme.fontFamilyMono};\n    font-size: 14px;\n    color: ${e.theme.brand.red};\n  }\n}\n\npre {\n  display: block;\n  overflow-x: auto;\n  padding: 0.75em 1em;\n  line-height: 1.4em;\n  position: relative;\n  background: ${e.theme.codeBackground};\n  border-radius: 4px;\n  border: 1px solid ${e.theme.codeBorder};\n  margin: .5em 0;\n\n  -webkit-font-smoothing: initial;\n  font-family: ${e.theme.fontFamilyMono};\n  direction: ltr;\n  text-align: left;\n  white-space: pre;\n  word-spacing: normal;\n  word-break: normal;\n  -moz-tab-size: 4;\n  -o-tab-size: 4;\n  tab-size: 4;\n  -webkit-hyphens: none;\n  -moz-hyphens: none;\n  -ms-hyphens: none;\n  hyphens: none;\n  color: ${e.theme.code};\n\n  code {\n    font-size: inherit;\n    background: none;\n    padding: 0;\n    border: 0;\n  }\n}\n\ntable {\n  width: 100%;\n  border-collapse: separate;\n  border-radius: ${i.blockRadius};\n  margin-top: 1em;\n  box-sizing: border-box;\n  border: 1px solid ${e.theme.divider};\n  border-left: 0;\n  border-spacing: 0;\n\n  * {\n    box-sizing: border-box;\n  }\n\n  tr {\n    position: relative;\n    border-bottom: 1px solid ${e.theme.divider};\n    border-color: inherit;\n  }\n\n  td,\n  th {\n    position: relative;\n    vertical-align: top;\n    position: relative;\n    padding: 4px 8px;\n    text-align: start;\n    min-width: 100px;\n    font-weight: normal;\n    border-left: 1px solid ${e.theme.divider};\n    border-top: 1px solid ${e.theme.divider};\n  }\n\n  th {\n    background: ${e.theme.background};\n    background-image: linear-gradient(\n      ${o(.75,e.theme.divider)},\n      ${o(.75,e.theme.divider)}\n    );\n    color: ${e.theme.textSecondary};\n    font-weight: 500;\n  }\n\n  tr:first-child th,\n  tr:first-child td {\n    border-top: 0;\n  }\n  tr:first-child th[data-first-column],\n  tr:first-child td[data-first-column] {\n    border-top-left-radius: ${i.blockRadius};\n  }\n  th[data-first-column][data-last-row],\n  td[data-first-column][data-last-row] {\n    border-bottom-left-radius: ${i.blockRadius};\n  }\n  tr:first-child th[data-last-column],\n  tr:first-child td[data-last-column] {\n    border-top-right-radius: ${i.blockRadius};\n  }\n  th[data-last-column][data-last-row],\n  td[data-last-column][data-last-row] {\n    border-bottom-right-radius: ${i.blockRadius};\n  }\n\n  td .component-embed {\n    padding: 4px 0;\n  }\n\n  td[data-bgcolor],\n  th[data-bgcolor] {\n    color: var(--cell-text-color);\n    background: linear-gradient(var(--cell-bg-color), var(--cell-bg-color)), linear-gradient(${e.theme.background}, ${e.theme.background});\n\n    p, a, p a {\n      color: var(--cell-text-color, inherit);\n    }\n\n    a, p a {\n      text-decoration: underline;\n      text-decoration-color: var(--cell-text-color, inherit);\n    }\n  }\n\n  .selectedCell {\n    /* Using box-shadow inset instead of background to allow overlay on cell background colors */\n    box-shadow: inset 0 0 0 9999px ${e.theme.tableSelectedBackground};\n\n    /* fixes Firefox background color painting over border:\n      * https://bugzilla.mozilla.org/show_bug.cgi?id=688556 */\n    background-clip: padding-box;\n  }\n\n  .${i.tableAddRow},\n  .${i.tableAddColumn} {\n    display: block;\n    position: absolute;\n    background: ${e.theme.accent};\n    cursor: var(--pointer);\n\n    &:hover::after {\n      width: 16px;\n      height: 16px;\n      z-index: 20;\n      background-color: ${e.theme.accent};\n      background-size: 16px 16px;\n      background-position: 50% 50%;\n      background-image: url(\"data:image/svg+xml;base64,${btoa(`<svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M12 5C11.4477 5 11 5.44772 11 6V11H6C5.44772 11 5 11.4477 5 12C5 12.5523 5.44772 13 6 13H11V18C11 18.5523 11.4477 19 12 19C12.5523 19 13 18.5523 13 18V13H18C18.5523 13 19 12.5523 19 12C19 11.4477 18.5523 11 18 11H13V6C13 5.44772 12.5523 5 12 5Z\" fill=\"white\"/></svg>`)}\")\n    }\n\n    // extra clickable area\n    &::before {\n      content: \"\";\n      display: block;\n      cursor: var(--pointer);\n      position: absolute;\n      width: 24px;\n      height: 24px;\n    }\n  }\n\n  .${i.tableAddRow} {\n    bottom: -1px;\n    left: -16px;\n    width: 0;\n    height: 2px;\n    z-index: 1;\n\n    &::after {\n      content: \"\";\n      position: absolute;\n      bottom: -1px;\n      left: -10px;\n      width: 4px;\n      height: 4px;\n      display: ${e.readOnly?`none`:`block`};\n      border-radius: 100%;\n      background-color: ${e.theme.divider};\n    }\n\n    &:hover {\n      width: calc(var(--table-width) - ${i.padding*1.5}px);\n    }\n\n    &:hover::after {\n      bottom: -7.5px;\n      left: -16px;\n    }\n\n    // extra clickable area\n    &::before {\n      bottom: -12px;\n      left: -18px;\n    }\n\n    &.first {\n      bottom: auto;\n      top: -1px;\n\n      &::before {\n        bottom: auto;\n        top: -12px;\n      }\n    }\n  }\n\n  .${i.tableAddColumn} {\n    top: -16px;\n    right: -1px;\n    width: 2px;\n    height: 0;\n    z-index: 1;\n\n    &::after {\n      content: \"\";\n      position: absolute;\n      top: -10px;\n      right: -1px;\n      width: 4px;\n      height: 4px;\n      display: ${e.readOnly?`none`:`block`};\n      border-radius: 100%;\n      background-color: ${e.theme.divider};\n    }\n\n    &:hover {\n      height: calc(var(--table-height) - ${i.padding}px + 6px);\n    }\n\n    &:hover::after {\n      top: -16px;\n      right: -7px;\n    }\n\n    // extra clickable area\n    &::before {\n      top: -16px;\n      right: -12px;\n    }\n\n    &.first {\n      right: auto;\n      left: -1px;\n\n      &::before {\n        right: auto;\n        left: -12px;\n      }\n    }\n  }\n\n  .${i.tableGripColumn} {\n    /* usage of ::after for all of the table grips works around a bug in\n     * prosemirror-tables that causes Safari to hang when selecting a cell\n     * in an empty table:\n     * https://github.com/ProseMirror/prosemirror/issues/947 */\n    &::after {\n      content: \"\";\n      cursor: grab;\n      position: absolute;\n      top: -16px;\n      left: 0;\n      width: 100%;\n      height: 12px;\n      background: ${e.theme.divider};\n      display: ${e.readOnly?`none`:`block`};\n    }\n\n    &:hover::after {\n      background: ${e.theme.text};\n    }\n\n    body.${i.tableDragging} &:hover::after {\n      background: ${e.theme.divider};\n    }\n    &.first::after {\n      border-top-left-radius: 3px;\n      border-bottom-left-radius: 3px;\n    }\n    &.selected::after {\n      background: ${e.theme.tableSelected};\n    }\n  }\n\n  [data-last-column] .${i.tableGripColumn}::after {\n    border-top-right-radius: 3px;\n    border-bottom-right-radius: 3px;\n  }\n\n  .${i.tableGripRow} {\n    &::after {\n      content: \"\";\n      cursor: grab;\n      position: absolute;\n      left: -16px;\n      top: 0;\n      height: 100%;\n      width: 12px;\n      background: ${e.theme.divider};\n      border-color: ${e.theme.background};\n      display: ${e.readOnly?`none`:`block`};\n    }\n\n    &:hover::after {\n      background: ${e.theme.text};\n    }\n\n    body.${i.tableDragging} &:hover::after {\n      background: ${e.theme.divider};\n    }\n    &.first::after {\n      border-top-left-radius: 3px;\n      border-top-right-radius: 3px;\n    }\n    &.selected::after {\n      background: ${e.theme.tableSelected};\n    }\n  }\n\n  [data-last-row] .${i.tableGripRow}::after {\n    border-bottom-left-radius: 3px;\n    border-bottom-right-radius: 3px;\n  }\n\n  .${i.tableGrip} {\n    &::after {\n      content: \"\";\n      cursor: var(--pointer);\n      background: ${e.theme.divider};\n      width: 13px;\n      height: 13px;\n      border-radius: 13px;\n      border: 2px solid ${e.theme.background};\n      position: absolute;\n      top: -18px;\n      left: -18px;\n      display: ${e.readOnly?`none`:`block`};\n      z-index: 10;\n    }\n\n    &:hover::after {\n      background: ${e.theme.text};\n    }\n    &.selected::after {\n      background: ${e.theme.tableSelected};\n    }\n    &.dragging::after {\n      background: ${e.theme.accent};\n      opacity: 0.5;\n    }\n  }\n\n  .${i.tableAddRow},\n  .${i.tableAddColumn},\n  .${i.tableGrip},\n  .${i.tableGripColumn},\n  .${i.tableGripRow} {\n    @media print {\n      display: none;\n    }\n  }\n}\n\n.${i.tableDragDropIndicator} {\n  position: absolute;\n  background: ${e.theme.accent};\n  pointer-events: none;\n  z-index: 100;\n  opacity: 0;\n  transition: opacity 100ms ease-in-out;\n\n  &.active {\n    opacity: 1;\n  }\n\n  &[data-type=\"row\"] {\n    height: 2px;\n    border-radius: 1px;\n  }\n\n  &[data-type=\"column\"] {\n    width: 2px;\n    border-radius: 1px;\n  }\n}\n\n.${i.tableGripRow},\n.${i.tableGripColumn} {\n  &.dragging::after {\n    cursor: