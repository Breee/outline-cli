ark?i.hexColorSwatchDark:i.hexColorSwatchLight} {\n  outline: 1px solid ${e.theme.codeBorder};\n}\n\nmark {\n  border-radius: 1px;\n  padding: 2px 0;\n  color: ${e.theme.text};\n\n  a {\n    color: ${e.theme.text};\n  }\n}\n\n.external-link {\n  cursor: pointer;\n  display: inline-block;\n  position: relative;\n  top: 2px;\n  width: 16px;\n  height: 16px;\n}\n\n.${i.codeBlock} {\n  position: relative;\n  font-size: 90%;\n\n  &:hover + .${i.codeBlockToggle},\n  &:focus-within + .${i.codeBlockToggle},\n  & + .${i.codeBlockToggle}:hover,\n  & + .${i.codeBlockToggle}:focus {\n    opacity: 1;\n  }\n}\n\n.${i.codeBlock}[data-language=none],\n.${i.codeBlock}[data-language=markdown] {\n  pre code {\n    color: ${e.theme.text};\n  }\n}\n\n.${i.codeBlock}[data-language=mermaid],\n.${i.codeBlock}[data-language=mermaidjs] {\n  ${!e.staticHTML&&n`\n      pre {\n        border-bottom-left-radius: 0;\n        border-bottom-right-radius: 0;\n        margin-bottom: -20px;\n        overflow: hidden;\n      }\n    `}\n\n  &:is(.code-active) + .mermaid-diagram-wrapper {\n    cursor: zoom-in;\n  }\n\n  // Hide code without display none so toolbar can still be positioned against it\n  &:not(.code-active) {\n    height: ${e.staticHTML||e.readOnly?`auto`:`0`};\n    margin: 0.5em 0 -0.75em 0px;\n    overflow: hidden;\n    position: relative;\n  }\n\n  &.ProseMirror-selectednode {\n    outline: none;\n\n    & + .mermaid-diagram-wrapper {\n      &:not(.empty) {\n        cursor: zoom-in;\n      }\n      outline: 2px solid ${e.theme.selected};\n    }\n  }\n}\n\n.ProseMirror[contenteditable=\"false\"] .${i.codeBlock}[data-language=mermaid],\n.ProseMirror[contenteditable=\"false\"] .${i.codeBlock}[data-language=mermaidjs] {\n    height: 0;\n    overflow: hidden;\n\n    & + .mermaid-diagram-wrapper {\n      cursor: zoom-in;\n    }\n}\n\n.ProseMirror.exported {\n    .${i.codeBlock}[data-language=mermaid],\n    .${i.codeBlock}[data-language=mermaidjs] {\n        height: auto;\n        overflow: visi